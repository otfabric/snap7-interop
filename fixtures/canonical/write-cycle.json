{
  "$schema": "../schema/fixture.schema.json",
  "schemaVersion": "1.0.0",
  "id": "write-cycle",
  "revision": 1,
  "description": "Accepted write mutates DB1 and is visible on subsequent read",
  "tags": ["db", "write"],
  "requires": ["area.db", "operation.read", "operation.write"],
  "server": {
    "rack": 0,
    "slot": 2,
    "pduSize": 480
  },
  "areas": [
    {
      "type": "db",
      "number": 1,
      "size": 32,
      "access": "read-write",
      "initial": {
        "hex": "00000000"
      }
    }
  ],
  "expectations": [
    {
      "operation": "write",
      "area": { "type": "db", "number": 1 },
      "offset": 0,
      "data": { "hex": "deadbeef" },
      "result": "accepted"
    },
    {
      "operation": "read",
      "area": { "type": "db", "number": 1 },
      "offset": 0,
      "length": 4,
      "result": { "hex": "deadbeef" }
    },
    {
      "operation": "final-state",
      "area": { "type": "db", "number": 1 },
      "offset": 0,
      "length": 4,
      "result": { "hex": "deadbeef" }
    }
  ]
}
