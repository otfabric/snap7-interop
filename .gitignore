# Build outputs
/bin/
/fixturectl
/dist/
/release/
*.o
*.a
*.so
*.dylib
*.exe

# Tooling caches
.cache/
.ruff_cache/
.mypy_cache/
.pytest_cache/
__pycache__/
*.pyc
.venv/
venv/
servers/python/.venv/

# Go
coverage.out
coverage.html
cover.*
*.test
**/testdata/fuzz/

# CMake / native builds
servers/native/build/
cmake-build-*/

# Runtime and reports
/reports/*
!/reports/.gitkeep
/run/
*.log

# Compiled fixtures generated locally (committed goldens live under fixtures/compiled/)
fixtures/compiled/*.tmp.json

# Editor and OS
.vscode/
.idea/
.cursor/
.DS_Store
*~

# Docker
docker.tar

# Secrets — never commit
.env
.env.*
!.env.example
credentials.json
*.pem
*.key
*.egg-info/

# Output of a bare `go build`, anchored so it can never hide a source folder
/tooling/fixturectl/fixturectl
/tooling/interop-probe/interop-probe
